{
  "compilerOptions": {
    "outDir": "dist",
    "target": "es2016",
    "lib": ["es2017", "dom"],
    "declaration": false,
    "module": "commonjs",
    "strictNullChecks": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules"]
}
