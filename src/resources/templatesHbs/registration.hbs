{{!-- Форма регистрации --}}

<form class="login">
  <div class="login__title">Создать аккаунт</div>
  <div class="login__fields">
    {{#each fields}}
      {{{this}}}
    {{/each}}
  </div>
  <div class="login__buttons">
    {{#each buttons}}
      {{{this}}}
    {{/each}}
    <a href="/login.html" class="login__buttons-link">Войти</a>
  </div>
</form>
