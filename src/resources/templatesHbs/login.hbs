{{!-- Форма логина --}}

<form class="login">
  <div class="login__title">Вход</div>
  <div class="login__fields">
    {{#each fields}}
      {{{this}}}
    {{/each}}
  </div>
  <div class="login__buttons">
    {{#each buttons}}
      {{{this}}}
    {{/each}}
    <a href="/registration.html" class="login__buttons-link">Нет аккаунта?</a>
  </div>
</form>
